//
// Оновлено: враховано зауваження ментора щодо типів полів та зв'язків
// - Узгоджено імена полів для імен (first_name/last_name)
// - phone залишено як varchar(20) (щоб зберегти '+' та ведучі нулі)
// - measurement -> decimal(6,2) для дробових вимірювань
// - duration_min і max_capacity -> smallint
// - Додано таблицю rooms та пов'язаність equipment_items і classes з rooms
// - attendance.class_id зроблено nullable (щоб записувати прихід без групового заняття)
// Link to our diagram:
// https://dbdiagram.io/d/team-3-6aa12ac6f476a8187a4b2427

//Anastasiia Khudych
Table members {
  id bigint [primary key, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  phone varchar(20) [not null]
  email varchar(100) [not null, unique]
}

enum membership_type {
  monthly
  yearly
  premium
}

Table memberships {
  id bigint [primary key, increment]
  member_id bigint [not null]
  type membership_type [not null]
  start_date date [default: `now()`]
  end_date date
}

Ref: memberships.member_id > members.id

enum goal_type {
  weight_loss
  muscle_gain
  endurance
  flexibility
  maintenance
}

Table fitness_goals {
  id bigint [primary key, increment]
  member_id bigint [not null]
  goal_type goal_type [not null]
  target_value decimal [not null]
  target_value_unit varchar(20)
  start_date date [not null]
  target_date date [not null]
  achieved_date date
}

Ref: fitness_goals.member_id > members.id

//Микола Астаф'єв
Table trainers {
  id bigint [primary key, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(100) [not null, unique]
  phone varchar(20)
  experience_years int [default: 0]
  hourly_rate decimal
  hired_at date
}

Table specializations {
  id bigint [primary key, increment]
  name varchar(100) [not null, unique]
}

Table trainer_specializations {
  trainer_id bigint [not null]
  specialization_id bigint [not null]

  indexes {
    (trainer_id, specialization_id) [pk]
  }
}

Ref: trainer_specializations.trainer_id > trainers.id
Ref: trainer_specializations.specialization_id > specializations.id

//Maksym Bielik
enum equipment_status {
  available
  in_use
  under_repair
  damaged
  decommissioned
}

Table equipment_types {
  id bigint [primary key, increment]
  name varchar(100) [not null]
  category varchar(50) [not null]
  weight_kg float
}

Table rooms {
  id smallint [primary key, increment]
  name varchar(50) [not null] // наприклад: "A101", "Studio 2"
  location varchar(100)
}

Table equipment_items {
  id bigint [primary key, increment]
  type_id bigint [not null]
  inventory_number varchar(50) [not null, unique]
  room_id smallint
  status equipment_status [not null, default: 'available']
  last_service_at date
  purchased_at date
}

Ref: equipment_items.type_id > equipment_types.id
Ref: equipment_items.room_id > rooms.id

Table progress {
  id bigint [primary key, increment]
  fitness_goal_id bigint [not null]
  measurement decimal(6,2) [not null]
  recorded_at date [not null]
  notes text
}

Ref: progress.fitness_goal_id > fitness_goals.id

enum session_status {
  scheduled
  completed
  cancelled
  no_show
}

Table personal_training {
  id bigint [primary key, increment]
  member_id bigint [not null]
  trainer_id bigint [not null]
  scheduled_at timestamp [not null]
  duration_min smallint [not null, default: 60]
  status session_status [not null, default: 'scheduled']
  is_paid boolean [not null, default: false]
  notes text
}

Ref: personal_training.member_id > members.id
Ref: personal_training.trainer_id > trainers.id

// Зв'язок: які предмети обладнання використовуються на заняттях
Table class_equipments {
  class_id bigint [not null]
  equipment_item_id bigint [not null]
  quantity smallint [default: 1]

  indexes {
    (class_id, equipment_item_id) [pk]
  }
}

Ref: class_equipments.class_id > classes.id
Ref: class_equipments.equipment_item_id > equipment_items.id

// Vladyslav Kurchyk
Table classes {
  id bigint [primary key, increment]
  name varchar(100) [not null]
  trainer_id bigint [not null]
  room_id smallint [not null]
  scheduled_at timestamp [not null]
  duration_min smallint [not null]
  max_capacity smallint [not null]
}

Ref: classes.trainer_id > trainers.id
Ref: classes.room_id > rooms.id

Table attendance {
  id bigint [primary key, increment]
  member_id bigint [not null]
  class_id bigint // nullable: NULL means приход в зал без групового заняття
  attended_at timestamp [not null]
}

Ref: attendance.member_id > members.id
Ref: attendance.class_id > classes.id
